{
  "name": "spatial-desktop-reui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "test:component": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "test:responsive": "playwright test --config=playwright.responsive.config.ts",
    "test:all": "npm run test:component && npm run test:e2e && npm run test:a11y && npm run test:responsive"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.1",
    "@radix-ui/react-separator": "1.1.0",
    "@testing-library/dom": "^10.4.1",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "lucide-react": "0.400.0",
    "motion": "12.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.0",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.0",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "axe-core": "4.10.2",
    "esbuild": "^0.25.5",
    "eslint": "9.9.0",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-security": "1.7.1",
    "jsdom": "24.1.0",
    "playwright": "^1.55.1",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}
