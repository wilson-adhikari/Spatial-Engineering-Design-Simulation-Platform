# assembly.obj - example assembly of 2 boxes - CC0
mtllib ../materials/default.mtl
o Box1
v -10 -5 -5
v 0 -5 -5
v 0 5 -5
v -10 5 -5
v -10 -5 5
v 0 -5 5
v 0 5 5
v -10 5 5
usemtl Steel
f 1 2 3 4
f 5 8 7 6
f 1 5 6 2
o Box2
v 0 -3 -3
v 20 -3 -3
v 20 3 -3
v 0 3 -3
v 0 -3 3
v 20 -3 3
v 20 3 3
v 0 3 3
usemtl Aluminum
f 9 10 11 12
f 13 16 15 14
